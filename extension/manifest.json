{
  "manifest_version": 3,
  "name": "求职工作台 - 本地自动填写",
  "version": "0.2.0",
  "description": "本地保存多份求职资料，分析招聘表单并在复核后填写已审核字段。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://career.huawei.com/*",
    "https://join.qq.com/*",
    "https://www.pwccn.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "求职工作台 - 本地自动填写"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://career.huawei.com/*",
        "https://join.qq.com/*",
        "https://www.pwccn.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["local-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
